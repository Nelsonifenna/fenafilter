# ---------------------------------------------------------------------------
# FenaFilter environment variables
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# All variables are read on the server only and are never sent to the browser.
# ---------------------------------------------------------------------------

# Google Gemini — reads fixtures from screenshots AND interprets your
# natural-language filtering instruction. Required to start an analysis.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default: gemini-3.1-flash-lite (text + image input, free tier).
# Check the real connection (local development): GET /api/health?details=1&verify=gemini
GEMINI_MODEL=

# API-Football (api-sports.io direct subscription) — real match statistics.
# Dashboard: https://dashboard.api-football.com
API_FOOTBALL_KEY=
# Optional: also fetch API-Football's own predictions (costs extra requests). true | false
API_FOOTBALL_ENABLE_PREDICTIONS=false

# Vercel Blob — PRIVATE storage for screenshots (required on Vercel; optional locally).
# Without it, local development stores files in ./.data
BLOB_READ_WRITE_TOKEN=

# Signs guest-session cookies. Required in production. At least 32 random characters.
# Generate in PowerShell (64 hex characters from a cryptographic random source):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString("x2") })
SESSION_SECRET=

# Protects the daily cleanup job (/api/cron/cleanup) on Vercel. Generate it the same way.
CRON_SECRET=

# Optional. Enables developer diagnostics at /api/health?details=1 in production
# (send it as: Authorization: Bearer <value>). Leave empty to disable them there.
DIAGNOSTICS_SECRET=
